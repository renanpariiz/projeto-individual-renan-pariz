# =============================================================
# Fase 1 - Containerização (DEV)
# Dockerfile para ambiente de desenvolvimento com hot-reload
# =============================================================

FROM node:20-alpine

# Diretório de trabalho dentro do container
WORKDIR /app

# Copiar apenas os arquivos de dependências primeiro (cache de layers)
COPY package*.json ./

# Instalar dependências de produção + dev
RUN npm install

# Copiar o restante do código
COPY . .

# Expor a porta do servidor
EXPOSE 3000

# Usar --watch nativo do Node.js 20 para hot-reload (sem precisar do nodemon)
CMD ["node", "--watch", "server.js"]
